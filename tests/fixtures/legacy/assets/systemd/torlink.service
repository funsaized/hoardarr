[Unit]
Description=Hoardarr Torlink server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/media
Environment=PATH=/home/media/.local/share/mise/installs/node/26.7.0/bin:/usr/local/bin:/usr/bin
Environment=TORLINK_STATE_DIR=/home/media/.local/state/hoardarr/torlink
WorkingDirectory=/home/media/Projects/torlink
ExecStart=/home/media/.local/share/mise/installs/node/26.7.0/bin/node /home/media/Projects/torlink/dist/cli.cjs serve --host 127.0.0.1 --port 9161 --to /home/media/Downloads/hoardarr/movies --seed-time 5m
Restart=no

[Install]
WantedBy=default.target

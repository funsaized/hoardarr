[Unit]
Description=Hoardarr Swamp server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/media
Environment=PATH=/home/media/.local/bin:/home/media/.local/share/mise/installs/node/26.7.0/bin:/usr/local/bin:/usr/bin
WorkingDirectory=/home/media/Projects/hoardarr
ExecStart=/home/media/.local/bin/swamp serve --repo-dir /home/media/Projects/hoardarr --host 127.0.0.1 --port 9090
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

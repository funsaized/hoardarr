@@ -1,17 +1,35 @@
-import { promises as fs } from "node:fs";
+import { promises as fs, mkdirSync, openSync, writeFileSync, fsyncSync, closeSync, renameSync } from "node:fs";
 import path from "node:path";
 
+// Publication is deliberately synchronous: a queued async save must never overwrite a later
+// successful pause/remove acknowledgement or the shutdown flush with an older snapshot.
 export function serializeWrites(): (task: () => Promise<void>) => Promise<void> {
-  let chain: Promise<void> = Promise.resolve();

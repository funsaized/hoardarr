+  return (task) => { try { return task(); } catch (error) { return Promise.reject(error); } };
+}
+export function syncDirectorySync(dir: string): void {
+  const fd = openSync(dir, "r");
+  try { fsyncSync(fd); } finally { closeSync(fd); }
+}
+export function writeJsonAtomicSync(file: string, data: unknown): void {
+  mkdirSync(path.dirname(file), {recursive: true});
+  const tmp = `${file}.sync.tmp`;
+  const fd = openSync(tmp, "w", 0o600);
+  try { writeFileSync(fd, JSON.stringify(data, null, 2)); fsyncSync(fd); } finally { closeSync(fd); }
+  renameSync(tmp, file);
+  syncDirectorySync(path.dirname(file));
 }

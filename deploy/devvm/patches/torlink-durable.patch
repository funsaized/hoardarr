+  writeJsonAtomicSync(file, data);
+}
+export async function readArray<T>(file: string, valid: (value: unknown) => value is T): Promise<T[]> {
+  let raw: string;
+  try { raw = await fs.readFile(file, "utf8"); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === "ENOENT") return []; throw error; }
+  const parsed: unknown = JSON.parse(raw);
+  if (!Array.isArray(parsed) || !parsed.every(valid)) throw new Error(`Corrupt persistent state: ${file}`);
+  return parsed;
+}
+export function fatalPersistence(_error: unknown): never {
+  console.error("Persistent state write failed; daemon inhibited. Inspect storage before restart.");
+  process.exit(74);
 }

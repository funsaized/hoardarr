@@ -0,0 +1,6 @@
+// Every test file has its own real state root. Concurrent workers must never share .tmp files.
+// Leave deletion until the runner exits: background engine teardown may still finish metadata I/O.
+import { mkdtempSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+process.env.TORLINK_STATE_DIR = mkdtempSync(path.join(os.tmpdir(), "hoardarr-torlink-test-"));
diff --git a/src/download/persist.metadata-crash.test.ts b/src/download/persist.metadata-crash.test.ts
new file mode 100644
index 0000000..494f2d8
--- /dev/null
+++ b/src/download/persist.metadata-crash.test.ts
@@ -0,0 +1,19 @@
+import { describe, it, expect } from "vitest";
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { spawnSync } from "node:child_process";
+
+describe("acknowledged torrent metadata", () => {
+  it("survives immediate process exit without waiting for a detached write", () => {
+    const root = mkdtempSync(join(tmpdir(), "torlink-metadata-ack-"));
+    try {
+      const id = "a".repeat(40), payload = "resume-metadata-before-ack";
+      const result = spawnSync(process.execPath, ["--import", "tsx", "--input-type=module", "-e",
+        `import { saveTorrentMeta } from './src/download/persist.ts'; saveTorrentMeta('${id}', Buffer.from('${payload}')); process.exit(88);`],
+        { cwd: process.cwd(), env: { ...process.env, TORLINK_STATE_DIR: root }, encoding: "utf8" });
+      expect(result.status, result.stderr).toBe(88);
+      expect(readFileSync(join(root, "data/torrents", id + ".torrent"), "utf8")).toBe(payload);
+    } finally { rmSync(root, { recursive: true, force: true }); }
+  });
+});

+
+Deno.test("Hoardarr durable control plane: conformance across fresh handles", async () => {
+  await withTempDir(async (dir) => {
+    await assertControlPlaneStoreConformance(() =>
+      new FileSystemControlPlaneStore(dir, Deno.mkdir, {})
+    );
+  });
+});
+
+Deno.test("Hoardarr durable control plane: file failure preserves prior token", async () => {
+  await withTempDir(async (dir) => {
+    const original = new FileSystemControlPlaneStore(dir, Deno.mkdir, {});
+    await original.put("auth/token", encoder.encode("prior"));
+    const failing = new FileSystemControlPlaneStore(dir, Deno.mkdir, {
+      syncFile: () => {
+        throw new Error("injected file sync failure");
+      },
+    });
+    await assertRejects(() =>
+      failing.put("auth/token", encoder.encode("replacement"))
+    );
+    assertEquals(decoder.decode((await original.get("auth/token"))!), "prior");
+    await assertRejects(() =>
+      failing.putIfAbsent("auth/other", encoder.encode("other"))
+    );
+    assertEquals(await original.get("auth/other"), null);
+  });
+});
+
+Deno.test("Hoardarr durable control plane: syncs the file before publishing and all parent entries", async () => {
+  await withTempDir(async (dir) => {
+    const events: string[] = [];
+    const store = new FileSystemControlPlaneStore(dir, Deno.mkdir, {
+      syncFile: async (file, paths) => {
+        assertEquals(
+          await new FileSystemControlPlaneStore(dir).get("nested/token"),
+          null,
+        );
+        events.push("file:" + paths.target);
+        await file.sync();
+      },
+      syncDirectory: async (path) => {
+        events.push("dir:" + path);
+        const handle = await Deno.open(path, { read: true });
+        try {
+          await handle.sync();
+        } finally {
+          handle.close();
+        }
+      },
+    });
+    await store.putIfAbsent("nested/token", encoder.encode("issued"));
+    assertEquals(events[0], "file:" + join(dir, "_control/nested/token"));
+    assertEquals(events.includes("dir:" + dir), true);
+    assertEquals(events.includes("dir:" + join(dir, "_control/nested")), true);
+    assertEquals(
+      decoder.decode(
+        (await new FileSystemControlPlaneStore(dir).get("nested/token"))!,
+      ),
+      "issued",
+    );
+  });
+});
+
+Deno.test("Hoardarr durable control plane: publication and deletion sync failures cannot acknowledge", async () => {
+  await withTempDir(async (dir) => {
+    const good = new FileSystemControlPlaneStore(dir, Deno.mkdir, {});
+    await good.put("auth/token", encoder.encode("prior"));
+    const failing = new FileSystemControlPlaneStore(dir, Deno.mkdir, {
+      syncDirectory: () => {
+        throw new Error("injected directory sync failure");
+      },
+    });
+    await assertRejects(() =>
+      failing.put("auth/token", encoder.encode("updated"))
+    );
+    await assertRejects(() => failing.delete("auth/token"));
+  });
+});
+
+Deno.test("Hoardarr durable control plane: unsupported hardlink cannot publish partial key", async () => {
+  await withTempDir(async (dir) => {
+    const link = Deno.link;
+    Deno.link = () => Promise.reject(new Deno.errors.NotSupported("injected"));
+    try {
+      const store = new FileSystemControlPlaneStore(dir, Deno.mkdir, {});
+      await assertRejects(() =>
+        store.putIfAbsent("auth/token", encoder.encode("issued"))
+      );
+      assertEquals(await store.get("auth/token"), null);
+      assertEquals(await store.list(""), []);
+    } finally {
+      Deno.link = link;
+    }
+  });
+});
